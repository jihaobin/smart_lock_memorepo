# 服务端
# 运行环境
NODE_ENV=development
# API 端口
PORT=3000
# 允许跨域访问的客户端 URL
NEXT_PUBLIC_APP_URL=
# 调试接口密钥
DEBUG_KEY=
# JWT 签名密钥
JWT_SECRET=
# JWT 有效期
JWT_EXPIRES_IN=1d
# 超级管理员用户名
SUPER_ADMIN_USERNAME=
# 超级管理员密码
SUPER_ADMIN_PASSWORD=

# 数据库
# 数据库用户名
DATABASE_USER=postgres
# 数据库密码
DATABASE_PASSWORD=
# 数据库名称
DATABASE_NAME=smart_lock
# PostgreSQL 连接 URL
DATABASE_URL=

# 客户端公开
# Expo API URL
EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Expo Socket URL
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# 第三方服务
# 邮件服务器主机
MAIL_HOST=
# 邮件服务器端口
MAIL_PORT=
# 邮件服务用户名
MAIL_USER=
# 邮件服务密码
MAIL_PASS=
# 邮件发件人名称
MAIL_FROM_NAME=
# 阿里云 AccessKey ID
ALIYUN_ACCESS_KEY_ID=
# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=
# 阿里云短信签名
ALIYUN_SMS_SIGN_NAME=
# 阿里云短信模板代码
ALIYUN_SMS_TEMPLATE_CODE=
# 阿里云 STS 角色 ARN
ALIYUN_STS_ROLE_ARN=
# 阿里云 STS 会话名称
ALIYUN_STS_ROLE_SESSION_NAME=SmartLockApp
# 阿里云 STS 策略
ALIYUN_STS_POLICY=
# 阿里云 STS 有效秒数
ALIYUN_STS_DURATION_SECONDS=3600
