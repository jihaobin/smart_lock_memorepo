# 项目共享环境变量示例文件
# 复制此文件为 .env 并填入真实值

# API 服务器设置
API_PORT=3000
API_HOST=localhost
API_URL=http://localhost:3000

# 数据库设置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_lock
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=smart_lock

# 认证设置
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# 客户端设置
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# 开发环境设置
NODE_ENV=development