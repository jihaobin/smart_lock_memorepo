{
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.suggest.autoImports": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/.expo": true,
    "**/android": true,
    "**/ios": true,
    "**/.metro-cache": true,
    "**/.turbo": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.expo/**": true,
    "**/android/**": true,
    "**/ios/**": true,
    "**/.metro-cache/**": true,
    "**/.turbo/**": true
  },
  "typescript.tsc.autoDetect": "off",
  "eslint.enable": false
}
