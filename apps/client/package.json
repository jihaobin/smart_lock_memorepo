{
  "name": "@smart-lock/client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "set NODE_OPTIONS=--max-old-space-size=8192 && set DARK_MODE=media && expo start --clear",
    "android": "set NODE_OPTIONS=--max-old-space-size=8192 && set DARK_MODE=media && expo start --android",
    "ios": "set NODE_OPTIONS=--max-old-space-size=8192 && set DARK_MODE=media && expo start --ios",
    "web": "set NODE_OPTIONS=--max-old-space-size=8192 && set DARK_MODE=media && expo start --web",
    "dev": "set NODE_OPTIONS=--max-old-space-size=8192 && set DARK_MODE=media && expo start",
    "test": "jest --watchAll",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "expo prebuild",
    "build": "echo \"No build step for Expo project in development mode\"",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/smartlock.xcworkspace -scheme smartlock -configuration Release",
    "prebuild": "expo prebuild",
    "clean": "node -e \"const fs = require('fs'); const opt = { recursive: true, force: true }; try { if(fs.existsSync('./ios')) fs.rmSync('./ios', opt); } catch(e) { console.log('Error removing ios:', e.message); } try { if(fs.existsSync('./android')) fs.rmSync('./android', opt); } catch(e) { console.log('Error removing android:', e.message); }\"",
    "clean-cache": "expo start --clear && rm -rf .metro-cache && rm -rf node_modules/.cache"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
