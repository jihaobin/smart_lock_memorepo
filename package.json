{
  "name": "smart-lock-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:android": "turbo run build:android",
    "build:ios": "turbo run build:ios",
    "prebuild": "turbo run prebuild",
    "dev": "turbo run dev",
    "dev:client": "pnpm --filter @smart-lock/client dev",
    "dev:api": "pnpm --filter @smart-lock/api dev",
    "dev:admin": "pnpm --filter @smart-lock/admin dev",
    "dev:admin-api": "turbo run dev --filter=@smart-lock/admin --filter=@smart-lock/api",
    "dev:client-api": "turbo run dev --filter=@smart-lock/client --filter=@smart-lock/api",
    "dev:all": "turbo run dev --filter=@smart-lock/client --filter=@smart-lock/admin --filter=@smart-lock/api",
    "env:init": "pnpm --filter @smart-lock/env env:init",
    "env:check": "pnpm --filter @smart-lock/env env:check",
    "env:generate": "pnpm --filter @smart-lock/env env:generate",
    "db:studio": "pnpm --filter @smart-lock/shared studio",
    "db:migrate": "pnpm --filter @smart-lock/shared migrate",
    "db:generate": "pnpm --filter @smart-lock/shared generate",
    "db:generate:migrate": "pnpm --filter @smart-lock/shared generate && pnpm --filter @smart-lock/shared migrate",
    "start": "turbo run start",
    "start:client": "pnpm --filter @smart-lock/client start",
    "start:api": "pnpm --filter @smart-lock/api start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean",
    "lint": "eslint --config eslint.config.mjs",
    "lint:fix": "eslint --config eslint.config.mjs --fix",
    "lint:api": "eslint --config eslint.config.mjs \"apps/api/**/*.{ts,js}\"",
    "lint:client": "eslint --config eslint.config.mjs \"apps/client/**/*.{ts,tsx,js,jsx}\"",
    "lint:api:fix": "eslint --config eslint.config.mjs --fix \"apps/api/**/*.{ts,js}\"",
    "lint:client:fix": "eslint --config eslint.config.mjs --fix \"apps/client/**/*.{ts,tsx,js,jsx}\"",
    "test": "turbo run test",
    "prepare": "husky install",
    "android": "pnpm --filter @smart-lock/client exec expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@darraghor/eslint-plugin-nestjs-typed": "^6.4.1",
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@tanstack/eslint-plugin-router": "^1.115.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-nestjs": "^1.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.5.0",
    "prettier": "^3.2.5",
    "turbo": "^2.5.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "dependencies": {
    "@hookform/resolvers": "5.1.0",
    "dotenv": "^16.4.7",
    "expo": "~52.0.46",
    "react": "18.3.1",
    "react-hook-form": "^7.57.0",
    "react-native": "0.76.9",
    "zod": "^3.25.64"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "1.1.12",
      "@alicloud/credentials": "^2.4.4"
    }
  }
}
