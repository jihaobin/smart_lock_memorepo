{
  "name": "@smart-lock/env",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "env:init": "tsx scripts/init.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "yaml": "^2.8.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
