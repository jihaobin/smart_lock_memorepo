        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"设备电量低-中级别\",\n  \"content\": \"您的智能锁电量低于20%，请及时充电\",\n  \"type\": \"DEVICE_LOW_BATTERY\",\n  \"userId\": \"{{user_id}}\",\n  \"deviceId\": \"device_103\",\n  \"data\": {\n    \"batteryLevel\": 18,\n    \"estimatedDaysRemaining\": 7\n  },\n  \"importanceLevel\": \"MEDIUM\",\n  \"notificationMethod\": \"app\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notifications"
          ]
        },
        "description": "发送中级别设备电量低通知示例"
      }
    },
    {
      "name": "设备离线(高级别)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"设备离线-高级别\",\n  \"content\": \"您的智能锁已离线超过2小时，请检查设备\",\n  \"type\": \"DEVICE_OFFLINE\",\n  \"userId\": \"{{user_id}}\",\n  \"deviceId\": \"device_107\",\n  \"data\": {\n    \"timestamp\": \"2024-04-02T18:00:00Z\",\n    \"lastOnlineTime\": \"2024-04-02T16:00:00Z\",\n    \"offlineDuration\": \"02:00:00\",\n    \"possibleReason\": \"power_issue\"\n  },\n  \"importanceLevel\": \"HIGH\",\n  \"notificationMethod\": \"sms\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notifications"
          ]
        },
        "description": "发送高级别设备离线通知示例"
      }
    },
    {
      "name": "设备故障(紧急级别)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"设备故障-紧急级别\",\n  \"content\": \"您的智能锁核心组件严重故障，设备无法正常工作，请立即联系客服\",\n  \"type\": \"DEVICE_BROKEN\",\n  \"userId\": \"{{user_id}}\",\n  \"deviceId\": \"device_104\",\n  \"data\": {\n    \"errorCode\": \"E501\",\n    \"component\": \"main_controller\",\n    \"severity\": \"critical\",\n    \"supportContact\": \"+86-10-12345678\"\n  },\n  \"importanceLevel\": \"CRITICAL\",\n  \"notificationMethod\": \"call\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notifications"
          ]
        },
        "description": "发送紧急级别设备故障通知示例"
      }
    }
  ],
